
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
}

enum DocumentStatus {
  PENDING
  PROCESSING
  REVIEW_REQUIRED
  VALIDATED
  REJECTED
  ERROR
}

enum DocumentType {
  INVOICE
  CERTIFICATE
  REPORT
  UNKNOWN
}

enum AuditAction {
  UPLOAD
  AUTO_EXTRACT
  UPDATE_FIELD
  VALIDATE_DOC
  DELETE_DOC
  EXPORT
}

// --- MODELS (The Entities) ---

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String   // Hashed
  name       String?  // Display name (optional, set via profile)
  avatarPath String?  // Path to avatar image in MinIO storage
  role       Role     @default(USER)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  documents Document[]
  auditLogs AuditLog[]
}

model Document {
  id           String         @id @default(uuid())
  originalName String
  storagePath  String         // Path to file in storage (local or S3/MinIO)
  mimeType     String         // e.g., "application/pdf"
  size         Int            // In bytes
  
  status       DocumentStatus @default(PENDING)
  type         DocumentType   @default(UNKNOWN)

  // Set by the AI service when the user uploads without picking a type.
  // `detectedType` is whatever the classifier returned (mirrors `type` once
  // applied), `classificationConfidence` is the classifier's confidence as a
  // 0-100 percentage so it lines up with the existing extraction confidence.
  detectedType             DocumentType?
  classificationConfidence Float?

  // Relations
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  
  extractedData ExtractedData? // 1:1 Relation (One doc has one extraction result)
  auditLogs     AuditLog[]     // 1:N Relation (One doc has history)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Soft delete: set this instead of destroying the row
  // Queries filter WHERE deletedAt IS NULL to exclude deleted documents
  deletedAt    DateTime?
  @@index([userId, deletedAt, status])
  @@index([userId, deletedAt, type])
  @@index([userId, deletedAt, createdAt])
}

model ExtractedData {
  id         String   @id @default(uuid())

  // Dynamic JSON payload for varying document types
  payload    Json

  confidence Float    @default(0.0) // Overall AI confidence score

  // Fields explicitly marked N/A by the reviewer
  // Format: { "expiryDate": { "reason": "Certificate has no expiry", "markedBy": "userId", "markedAt": "ISO" } }
  fieldOverrides Json?

  // Relations
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  description String?     // e.g., "User changed total from 500 to 520"

  // --- ADDED FOR HITL DATA VERSIONING ---
  oldValue    Json?       
  newValue    Json?       

  // Relations
  userId      String?     // Optional (System might do actions too)
  user        User?       @relation(fields: [userId], references: [id])

  // Nullable: if the document is hard-deleted, the log survives as an orphan (compliance)
  // SetNull: automatically sets documentId to NULL instead of deleting the log row
  documentId  String?
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  timestamp   DateTime    @default(now())
  
    // --- INDEXES ---
  // Covers getUserRecentLogs and findAll (ordered by timestamp)
  @@index([userId, timestamp])
  // Covers getDocumentHistory
  @@index([documentId, timestamp])

}